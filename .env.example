POSTGRES_DB=courtstats
POSTGRES_USER=courtstats_user
POSTGRES_PASSWORD=your_password_here

DATABASE_URL=postgresql+psycopg://courtstats_user:your_password_here@127.0.0.1:5432/courtstats
TEST_DATABASE_URL=postgresql+psycopg://courtstats_user:your_password_here@127.0.0.1:5432/courtstats_test

APP_ENV=development

SESSION_SECRET=replace_with_a_long_random_secret
SESSION_COOKIE_SECURE=false

# Production requirements:
# APP_ENV=production
# SESSION_COOKIE_SECURE=true
# SESSION_SECRET must be a unique random value
# of at least 32 characters.